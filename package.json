{
  "name": "openchamber-context-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenChamber 扩展与 OpenCode Collector：查看当前请求的上下文占用",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "dev": "bun run scripts/dev.ts"
  },
  "devDependencies": {
    "@openchamber/sdk": "^2.5.3",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.2"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=1.22.0"
    },
    "contributes": {
      "panel": {
        "id": "context-map",
        "name": "Context Map",
        "icon": "map-2",
        "entry": "panel/index.html"
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host"
      }
    }
  }
}
